<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Écran 2 : Saisir le nouveau mot de passe
    Controller : tn.dhc.controllers.ResetPasswordController
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.dhc.controllers.ResetPasswordController"
      alignment="CENTER"
      spacing="14"
      style="-fx-background-color: #f5f7fa;"
      minWidth="420" minHeight="420">

    <padding><Insets topRightBottomLeft="40"/></padding>

    <!-- Titre -->
    <Label text="Nouveau mot de passe"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>

    <Label text="Collez le lien reçu par email, puis choisissez votre nouveau mot de passe."
           wrapText="true" maxWidth="340"
           style="-fx-text-fill: #555; -fx-font-size: 13px; -fx-text-alignment: center;"/>

    <!-- Champ lien -->
    <TextField fx:id="linkField"
               promptText="Collez ici le lien reçu par email"
               maxWidth="340"
               style="-fx-font-size: 12px; -fx-padding: 9 14; -fx-background-radius: 8;
                      -fx-border-radius: 8; -fx-border-color: #ccc;"/>

    <Separator maxWidth="340"/>

    <!-- Nouveau mot de passe -->
    <Label text="Nouveau mot de passe" alignment="CENTER_LEFT" maxWidth="340"
           style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
    <StackPane maxWidth="340">
        <PasswordField fx:id="newPasswordField"
                       promptText="Au moins 8 caractères"
                       style="-fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8;
                              -fx-border-radius: 8; -fx-border-color: #ccc;"/>
        <TextField fx:id="newPasswordVisible"
                   promptText="Au moins 8 caractères"
                   visible="false"
                   style="-fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8;
                          -fx-border-radius: 8; -fx-border-color: #ccc;"/>
    </StackPane>

    <!-- Confirmer mot de passe -->
    <Label text="Confirmer le mot de passe" alignment="CENTER_LEFT" maxWidth="340"
           style="-fx-font-size: 13px; -fx-text-fill: #333;"/>
    <StackPane maxWidth="340">
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Répétez le mot de passe"
                       style="-fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8;
                              -fx-border-radius: 8; -fx-border-color: #ccc;"/>
        <TextField fx:id="confirmPasswordVisible"
                   promptText="Répétez le mot de passe"
                   visible="false"
                   style="-fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8;
                          -fx-border-radius: 8; -fx-border-color: #ccc;"/>
    </StackPane>

    <!-- Toggle visibilité -->
    <CheckBox text="Afficher le mot de passe"
              onAction="#togglePasswordVisibility"
              style="-fx-font-size: 12px; -fx-text-fill: #555;"/>

    <!-- Message de statut -->
    <Label fx:id="statusLabel" visible="false" wrapText="true" maxWidth="340"
           style="-fx-font-size: 12px;"/>

    <!-- Bouton confirmer -->
    <Button fx:id="resetButton"
            text="Réinitialiser le mot de passe"
            onAction="#handleReset"
            defaultButton="true"
            maxWidth="340"
            style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-font-weight: bold;
                   -fx-padding: 11 0; -fx-background-radius: 8; -fx-cursor: hand;">
        <VBox.margin><Insets top="4"/></VBox.margin>
    </Button>

    <!-- Lien retour -->
    <Hyperlink text="← Retour à la connexion"
               onAction="#handleBackToLogin"
               style="-fx-text-fill: #1a73e8; -fx-font-size: 13px; -fx-border-color: transparent;"/>

</VBox>
