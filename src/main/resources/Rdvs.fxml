<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.dhc.controllers.Rdvs">
   <children>
      <TabPane layoutX="20.0" layoutY="20.0" prefHeight="720.0" prefWidth="1250.0" style="-fx-font-size:14px; -fx-background-color:#f5f5f5;" stylesheets="@theme.css" tabClosingPolicy="UNAVAILABLE">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <tabs>
            <Tab text="📋 Liste des rendez-vous">
               <content>
                  <VBox spacing="15" style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                           <children>
                              <Label prefHeight="30.0" prefWidth="152.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#00b3a6;" text="⏰ Rendez-vous" />
                              <TextField fx:id="RechRdvText" prefHeight="38.0" prefWidth="480.0" promptText="Recherche..." />
                              <Button mnemonicParsing="false" onAction="#RechRdv" prefHeight="36.0" prefWidth="58.0" styleClass="btn-primary" text="🔍" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button mnemonicParsing="false" onAction="#refreshRdv" prefHeight="45" prefWidth="130" style="-fx-font-size:14px;" styleClass="btn-secondary" text="🔄 Actualiser" />
                           </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="580"
                                   style="-fx-background-color:transparent; -fx-background:transparent;"
                                   VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="rdvCardsContainer" spacing="10" style="-fx-padding:4;" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="➕ Ajout">
               <content>
                  <VBox spacing="15" style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                     <children>
                        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: linear-gradient(to right, #00b3a6, #00d4c8); -fx-background-radius: 12; -fx-padding: 15;" stylesheets="@theme.css">
                           <children>
                              <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" stylesheets="@theme.css" text="📍➕ Ajouter un Rendez-vous" textFill="WHITE" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox prefHeight="78.0" prefWidth="860.0" spacing="15">
                           <children>
                              <VBox maxWidth="Infinity" spacing="15" HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox prefHeight="104.0" prefWidth="836.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                                       <children>
                                          <HBox prefHeight="100.0" prefWidth="200.0">
                                             <children>
                                                <VBox prefHeight="74.0" prefWidth="330.0">
                                                   <children>
                                                      <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00b3a6;" text="Motif" />
                                                      <TextField fx:id="addRdvMotif" prefHeight="38.0" prefWidth="313.0" promptText="Motif...." />
                                                   </children>
                                                </VBox>
                                                <Region prefHeight="74.0" prefWidth="121.0" />
                                                <VBox prefHeight="75.0" prefWidth="190.0">
                                                   <children>
                                                      <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00b3a6;" text="Statut" />
                                                      <ComboBox fx:id="addRdvStatut" prefWidth="150.0" promptText="Statut..." stylesheets="@theme.css" />
                                                   </children>
                                                </VBox>
                                                <VBox prefHeight="75.0" prefWidth="154.0">
                                                   <children>
                                                      <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00b3a6;" text="Priorité" />
                                                      <ComboBox fx:id="addRdvPriorite" prefWidth="150.0" promptText="Priorité..." stylesheets="@theme.css" />
                                                   </children>
                                                </VBox>
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              <VBox maxWidth="Infinity" spacing="15" HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox prefHeight="356.0" prefWidth="295.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00b3a6;" text="📅 Date" />
                                          <DatePicker fx:id="addCreneauDate" prefHeight="38.0" prefWidth="321.0" stylesheets="@theme.css" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 5 0 0 0;">
                           <children>
                              <Button onAction="#ajouterRdv" prefHeight="40" prefWidth="180" style="-fx-background-color: linear-gradient(#00b3a6, #009988); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;" text="✓ Ajouter le Rdv" />
                              <Button onAction="#annuler" prefHeight="40" prefWidth="120" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;" text="✗ Annuler" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</AnchorPane>
