<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Écran 2 : Saisir le code OTP + nouveau mot de passe
    Controller : tn.dhc.controllers.ResetPasswordController
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.dhc.controllers.ResetPasswordController"
      alignment="CENTER"
      spacing="13"
      style="-fx-background-color: #f5f7fa;"
      minWidth="400" minHeight="460">

    <padding><Insets topRightBottomLeft="40"/></padding>

    <!-- Titre -->
    <Label text="Réinitialiser le mot de passe"
           style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>

    <!-- Email de destination (injecté via setEmail) -->
    <Label fx:id="emailDisplayLabel"
           text="Code envoyé à : …"
           style="-fx-text-fill: #555; -fx-font-size: 12px;"/>

    <Separator maxWidth="320"/>

    <!-- Champ code OTP -->
    <Label text="Code de vérification (6 chiffres)"
           style="-fx-font-size: 13px; -fx-text-fill: #333;" maxWidth="320"/>

    <TextField fx:id="codeField"
               promptText="ex : 483921"
               maxWidth="320"
               style="-fx-font-size: 18px; -fx-padding: 10 14;
                      -fx-background-radius: 8; -fx-border-radius: 8;
                      -fx-border-color: #ccc; -fx-alignment: center;
                      -fx-letter-spacing: 4px;"/>

    <Separator maxWidth="320"/>

    <!-- Nouveau mot de passe -->
    <Label text="Nouveau mot de passe"
           style="-fx-font-size: 13px; -fx-text-fill: #333;" maxWidth="320"/>
    <StackPane maxWidth="320">
        <PasswordField fx:id="newPasswordField"
                       promptText="Au moins 8 caractères"
                       style="-fx-font-size: 14px; -fx-padding: 10 14;
                              -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ccc;"/>
        <TextField fx:id="newPasswordVisible"
                   promptText="Au moins 8 caractères"
                   visible="false"
                   style="-fx-font-size: 14px; -fx-padding: 10 14;
                          -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ccc;"/>
    </StackPane>

    <!-- Confirmer mot de passe -->
    <Label text="Confirmer le mot de passe"
           style="-fx-font-size: 13px; -fx-text-fill: #333;" maxWidth="320"/>
    <StackPane maxWidth="320">
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Répétez le mot de passe"
                       style="-fx-font-size: 14px; -fx-padding: 10 14;
                              -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ccc;"/>
        <TextField fx:id="confirmPasswordVisible"
                   promptText="Répétez le mot de passe"
                   visible="false"
                   style="-fx-font-size: 14px; -fx-padding: 10 14;
                          -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ccc;"/>
    </StackPane>

    <!-- Toggle visibilité -->
    <CheckBox text="Afficher les mots de passe"
              onAction="#togglePasswordVisibility"
              style="-fx-font-size: 12px; -fx-text-fill: #555;"/>

    <!-- Message de statut -->
    <Label fx:id="statusLabel" visible="false" wrapText="true" maxWidth="320"
           style="-fx-font-size: 12px;"/>

    <!-- Bouton confirmer -->
    <Button fx:id="resetButton"
            text="Réinitialiser le mot de passe"
            onAction="#handleReset"
            defaultButton="true"
            maxWidth="320"
            style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-font-weight: bold;
                   -fx-padding: 11 0; -fx-background-radius: 8; -fx-cursor: hand;">
        <VBox.margin><Insets top="4"/></VBox.margin>
    </Button>

    <Hyperlink text="← Retour à la connexion"
               onAction="#handleBackToLogin"
               style="-fx-text-fill: #1a73e8; -fx-font-size: 13px; -fx-border-color: transparent;"/>

</VBox>
