<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
    Écran 1 : Mot de passe oublié
    Controller : tn.dhc.controllers.ForgotPasswordController
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.dhc.controllers.ForgotPasswordController"
      alignment="CENTER"
      spacing="16"
      style="-fx-background-color: #f5f7fa;"
      minWidth="400" minHeight="320">

    <padding><Insets topRightBottomLeft="40"/></padding>

    <!-- Titre -->
    <Label text="Mot de passe oublié"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>

    <Label text="Saisissez votre email pour recevoir un lien de réinitialisation."
           wrapText="true" maxWidth="320"
           style="-fx-text-fill: #555; -fx-font-size: 13px; -fx-text-alignment: center;"/>

    <!-- Champ email -->
    <TextField fx:id="emailField"
               promptText="votre@email.com"
               maxWidth="320"
               style="-fx-font-size: 14px; -fx-padding: 10 14; -fx-background-radius: 8;
                      -fx-border-radius: 8; -fx-border-color: #ccc;"/>

    <!-- Message de statut (caché par défaut) -->
    <Label fx:id="statusLabel" visible="false" wrapText="true" maxWidth="320"
           style="-fx-font-size: 12px;"/>

    <!-- Bouton envoyer -->
    <Button fx:id="sendButton"
            text="Envoyer le lien"
            onAction="#handleSendLink"
            defaultButton="true"
            maxWidth="320"
            style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-font-weight: bold;
                   -fx-padding: 11 0; -fx-background-radius: 8; -fx-cursor: hand;">
        <VBox.margin><Insets top="4"/></VBox.margin>
    </Button>

    <!-- Lien retour -->
    <Hyperlink text="← Retour à la connexion"
               onAction="#handleBackToLogin"
               style="-fx-text-fill: #1a73e8; -fx-font-size: 13px; -fx-border-color: transparent;"/>

</VBox>
